# ============================================================================
# MediNova AI - Backend Environment Configuration
# ============================================================================
# This is an example configuration file. Copy this to .env and update values.
# NEVER commit the actual .env file with real credentials to version control!
# ============================================================================

# ── Application Configuration ─────────────────────────────────────────────────
APP_NAME=MediNova AI
APP_VERSION=1.0.0
APP_DESCRIPTION=Multi-Agent Healthcare Intelligence Platform
ENVIRONMENT=development  # development | staging | production

# ── Server Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=True
RELOAD=True
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text

# ── MongoDB Configuration ─────────────────────────────────────────────────────
# Get your connection string from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?options
MONGODB_URL=mongodb+srv://your-username:your-password@cluster0.mongodb.net/medinova_ai?retryWrites=true&w=majority&appName=Cluster0&tls=true
MONGODB_DB_NAME=medinova_ai
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50

# ── JWT Configuration ─────────────────────────────────────────────────────────
# SECURITY: Generate strong random keys using: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use different keys for access and refresh tokens
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING_FOR_ACCESS_TOKENS
JWT_REFRESH_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_64_CHARACTER_STRING_FOR_REFRESH_TOKENS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30  # 30 minutes
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7  # 7 days

# ── CORS Configuration ────────────────────────────────────────────────────────
# Development: Include localhost origins
# Production: ONLY include your production domains (e.g., https://app.medinova.ai)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used for generating QR codes, email links, and redirects
# Development: http://localhost:5173
# Production: https://app.medinova.ai
FRONTEND_URL=http://localhost:5173

# ── AI Configuration ──────────────────────────────────────────────────────────
# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
# Format should start with: AIza...
GEMINI_API_KEY=AIzaSy_YOUR_ACTUAL_GEMINI_API_KEY_HERE

# Legacy OpenAI key (kept for backward compatibility, not currently used)
OPENAI_API_KEY=

# ── File Upload Configuration ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50  # Maximum file size in megabytes
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/bmp
ALLOWED_DOC_TYPES=application/pdf

# ── Rate Limiting Configuration ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=True

# Redis URL for rate limiting (production: use actual Redis server)
# Development: memory:// (in-memory, not shared across workers)
# Production: redis://localhost:6379 or rediss://redis-cloud-host:6380 (SSL)
REDIS_URL=memory://

# Authentication Rate Limits (per IP address)
# These are security-focused production-ready values
# For development testing, you can increase these temporarily
RATE_LIMIT_LOGIN=5/15minutes  # Brute force protection
RATE_LIMIT_REGISTER=5/hour  # Spam prevention
RATE_LIMIT_PASSWORD=5/15minutes  # Password change/reset limits

# AI Service Rate Limits (per authenticated user)
RATE_LIMIT_AI_CHAT=30/minute  # AI chat requests
RATE_LIMIT_AI_ANALYZE=10/minute  # AI analysis/document processing

# OCR Service Rate Limits (per authenticated user)
# OCR is resource-intensive, keep conservative
RATE_LIMIT_OCR=10/minute

# Default Rate Limit (for other endpoints)
RATE_LIMIT_DEFAULT=100/minute

# ── Email Configuration (SMTP) ────────────────────────────────────────────────
# Required for: email verification, password reset, notifications
# 
# Gmail Example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@gmail.com
#   SMTP_PASSWORD=your-app-specific-password  (NOT your regular Gmail password!)
#   Note: Enable 2FA and generate App Password: https://myaccount.google.com/apppasswords
#
# SendGrid Example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=your-sendgrid-api-key
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-specific-password-here
SMTP_FROM_EMAIL=noreply@medinova.ai
SMTP_FROM_NAME=MediNova AI

# ── Google OAuth Configuration ────────────────────────────────────────────────
# Set up OAuth 2.0 credentials: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:5173/auth/google/callback (development)
#                             or: https://app.medinova.ai/auth/google/callback (production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── Cloud Storage (Optional - Future Enhancement) ─────────────────────────────
# Uncomment and configure when moving to cloud storage for file uploads
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=medinova-documents
# AWS_REGION=us-east-1

# ============================================================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT:
# ============================================================================
# ✓ Change all JWT secrets to strong random values
# ✓ Use real MongoDB Atlas cluster (not local MongoDB)
# ✓ Configure IP whitelist in MongoDB Atlas
# ✓ Set ENVIRONMENT=production
# ✓ Update CORS_ORIGINS to only include production domains
# ✓ Set up proper SMTP credentials for email
# ✓ Use Redis server for rate limiting (not memory://)
# ✓ Verify all API keys are valid and have proper permissions
# ✓ Enable HTTPS/TLS in production
# ✓ Set up proper logging and monitoring
# ✓ Review rate limits for your expected traffic
# ============================================================================

